<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="dev.ulduar.Constellar1.Observer">
    <!-- a{sv} key vocabulary: data/dev.ulduar.Constellar1.spec.yaml -->
    <property name="Activity" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>

    <property name="Location" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>

    <method name="Pause"/>
    <method name="Resume"/>
    <method name="StartManualRecording"/>
    <method name="StopManualRecording"/>
    <method name="ReloadConfig"/>
    <method name="ListRecordings">
      <arg name="filter" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
      <arg name="recordings" type="as" direction="out"/>
    </method>
    <method name="DeleteRecording">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="GetConfig">
      <arg name="config" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="SetConfig">
      <arg name="config" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
    </method>

    <signal name="ActivityEnded">
      <arg name="path" type="o"/>
      <arg name="activity" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
    </signal>

    <signal name="Error">
      <arg name="code" type="s"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>

  <!-- Object-path contract -->

  <interface name="dev.ulduar.Constellar1.Activity">
    <property name="Type" type="s" access="read"/>
    <property name="StartTime" type="x" access="read"/>
    <property name="StopTime" type="x" access="read"/>
    <property name="Outcome" type="s" access="read"/>
    <property name="Recording" type="o" access="read"/>
  </interface>

  <interface name="dev.ulduar.Constellar1.Activity.Encounter">
    <property name="EncounterId" type="u" access="read"/>
    <property name="EncounterName" type="s" access="read"/>
    <property name="Difficulty" type="s" access="read"/>
    <property name="DifficultyId" type="u" access="read"/>
  </interface>

  <interface name="dev.ulduar.Constellar1.Activity.Dungeon">
    <property name="ZoneId" type="u" access="read"/>
    <property name="KeystoneLevel" type="u" access="read"/>
    <property name="ChallengeMapId" type="u" access="read"/>
    <property name="DurationMs" type="x" access="read"/>
  </interface>

  <interface name="dev.ulduar.Constellar1.Recording">
    <property name="Path" type="s" access="read"/>
    <property name="State" type="s" access="read"/>
    <property name="DurationMs" type="x" access="read"/>
    <property name="Activities" type="ao" access="read"/>

    <method name="Delete"/>
  </interface>

  <!-- Standard freedesktop interface on the root object -->
  <interface name="org.freedesktop.DBus.ObjectManager">
    <method name="GetManagedObjects">
      <arg name="objects" type="a{oa{sa{sv}}}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="DBusManagerStruct"/>
    </method>

    <signal name="InterfacesAdded">
      <arg name="object" type="o"/>
      <arg name="interfaces" type="a{sa{sv}}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMapMap"/>
    </signal>

    <signal name="InterfacesRemoved">
      <arg name="object" type="o"/>
      <arg name="interfaces" type="as"/>
    </signal>
  </interface>
</node>
