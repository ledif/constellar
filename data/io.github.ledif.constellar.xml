<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="io.github.ledif.constellar.Observer">
    <!-- Activity: the player's current instanced activity. Empty dict when none.
         Keys (see src/common/ActivityKeys.h):
           type          s   "encounter" | "dungeon"
           encounterId   u   encounter only
           encounterName s   encounter only
           difficulty    s   encounter only; LFR|Normal|Heroic|Mythic|Unknown
           difficultyId  u   encounter only; raw WoW difficultyID
           challengeMapId u  dungeon only
           zoneId        u   dungeon only
           keystoneLevel u   dungeon only
           startTime     x   unix epoch milliseconds
         ActivityEnded additionally carries:
           success       b
           durationMs    x   dungeon only
           stopTime      x   unix epoch milliseconds -->
    <property name="Activity" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>

    <!-- Location: where the player is. Orthogonal to Activity — you are in a location
         whether or not you are pulling a boss. Two independently-updated halves;
         either or both may be absent before their first event. Empty dict before
         either has ever fired.
           uiMapId          u    MAP_CHANGE; the cartographic map (M-key)
           uiMapName        s    MAP_CHANGE
           uiMapBounds      ad   MAP_CHANGE; [x0,x1,y0,y1] world bounds, omitted when invalid
           zoneInstanceId   u    ZONE_CHANGE; Map.dbc id, 0 in open world
           zoneName         s    ZONE_CHANGE; real zone text
           zoneDifficultyId u    ZONE_CHANGE; 0 when not instanced -->
    <property name="Location" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>

    <method name="Pause"/>
    <method name="Resume"/>
    <method name="StartManualRecording"/>
    <method name="StopManualRecording"/>
    <method name="ReloadConfig"/>
    <!-- recordings out-arg is a list of recording IDs in Phase 0; grows into
         full metadata dicts once MetadataStore lands in Phase 1. -->
    <method name="ListRecordings">
      <arg name="filter" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
      <arg name="recordings" type="as" direction="out"/>
    </method>
    <method name="DeleteRecording">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="GetConfig">
      <arg name="config" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="SetConfig">
      <arg name="config" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
    </method>

    <signal name="ActivityEnded">
      <arg name="activity" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </signal>

    <signal name="Error">
      <arg name="code" type="s"/>
      <arg name="message" type="s"/>
    </signal>
  </interface>
</node>
